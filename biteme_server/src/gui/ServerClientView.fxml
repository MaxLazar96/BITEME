<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="793.0" prefWidth="392.0" spacing="10" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="server.ServerClientViewController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
    
    <!-- New input fields for database name, password, and port number -->
    <Label text="Database Name:" />
    <TextField fx:id="dbNameField" />
    <Label text="Database Password:" />
    <TextField fx:id="dbPasswordField" />
    <Label text="IP:" />
    <TextField fx:id="ipHost" disable="true" />
    <Label text="Port:" />
    <TextField fx:id="portField" />
    <Button onAction="#handleConnectButtonAction" text="Connect">
      <VBox.margin>
         <Insets left="150.0" />
      </VBox.margin></Button>

    <!-- Existing TableView -->
    <TableView fx:id="clientTable" prefHeight="403.0" prefWidth="248.0">
        <columns>
            <TableColumn fx:id="ipColumn" prefWidth="114.0" text="IP Address" />
            <TableColumn fx:id="hostColumn" prefWidth="146.0" text="Host Name" />
            <TableColumn fx:id="statusColumn" prefWidth="98.0" text="Status" />
        </columns>
    </TableView>
    <Button fx:id="exitID" mnemonicParsing="false" onAction="#handleExitButton" text="Exit">
        <VBox.margin>
            <Insets left="160.0" />
        </VBox.margin>
    </Button>
</VBox>

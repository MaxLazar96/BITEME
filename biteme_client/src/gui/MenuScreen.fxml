<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<TabPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.MenuController">

    <!-- Entrees Tab -->
 <Tab closable="false" text="Entrees">
        <VBox prefHeight="481.0" prefWidth="654.0">
            <TableView fx:id="entreesTableView">
                <columns>
                    <TableColumn fx:id="entreeNameColumn" prefWidth="118.0" text="Dish Name" />
                    <TableColumn fx:id="entreeDescriptionColumn" prefWidth="120.0" text="Description" />
                    <TableColumn fx:id="entreePriceColumn" prefWidth="82.0" text="Price" />
                    <TableColumn fx:id="entreeRoastLevelColumn" prefWidth="101.0" text="Roast Level">
                        <cellFactory>
                            <client.ComboBoxTableCellFactory />
                        </cellFactory>
                    </TableColumn>
                    <TableColumn fx:id="entreeRemarkColumn" prefWidth="101.0" text="Remarks">
                        <cellFactory>
                            <client.TextFieldTableCellFactory />
                        </cellFactory>
                    </TableColumn>
                    <TableColumn fx:id="entreeAddColumn" prefWidth="101.0" text="Add">
                        <cellFactory>
                            <client.ButtonTableCellFactory />
                        </cellFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- Starters Tab -->
    <Tab closable="false" text="Starters">

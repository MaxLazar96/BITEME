    <!-- Cart Tab -->
    <Tab closable="false" text="Your Cart">
        <VBox fx:id="cartSection" spacing="10">
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="125.0" text="Your Cart:">
                <font>
                    <Font name="Arial Unicode MS" size="22.0" />
                </font>
            </Label>
            <TableView fx:id="cartTableView">
                <columns>
                    <TableColumn fx:id="cartDishNameColumn" prefWidth="108.0" text="Dish Name" />
                    <TableColumn fx:id="cartQuantityColumn" prefWidth="108.0" text="Quantity" />
                    <TableColumn fx:id="cartPriceColumn" prefWidth="81.0" text="Price" />
                    <TableColumn fx:id="cartRemoveColumn" text="Remove" />
                    <TableColumn fx:id="cartRemarksColumn" prefWidth="200.0" text="Remarks" />
                    
                </columns>
            </TableView>
            <HBox prefWidth="542.0" spacing="10">
                <Button onAction="#handleCheckoutButton" text="Checkout" />
            </HBox>
        </VBox>
    </Tab>
    
</TabPane>

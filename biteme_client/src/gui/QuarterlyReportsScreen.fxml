<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="686.0" prefWidth="894.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.QuarterlyReportsController">
    <Label layoutX="362.0" layoutY="14.0" text="Quarterly Reports" underline="true">
      <font>
         <Font size="22.0" />
      </font></Label>
    <ComboBox fx:id="quarterComboBox" layoutX="336.0" layoutY="67.0" />
    <Button fx:id="generateButton" layoutX="480.0" layoutY="67.0" onAction="#handleGenerateReport" text="Generate" />

    <BarChart fx:id="ordersChart" layoutX="34.0" layoutY="139.0" prefHeight="250.0" prefWidth="821.0">
        <xAxis>
            <CategoryAxis label="Date" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Number of Orders" />
        </yAxis>
    </BarChart>

    <BarChart fx:id="revenueChart" layoutX="28.0" layoutY="400.0" prefHeight="250.0" prefWidth="833.0">
        <xAxis>
            <CategoryAxis label="Date" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Total Revenue" />
        </yAxis>
    </BarChart>
   <Label layoutX="214.0" layoutY="72.0" text="Choose quarter:" />
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="350.0" prefWidth="753.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.WatchReportsController">
    
    <!-- Title Label -->
    <Label layoutX="277.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Watch Reports" underline="true" AnchorPane.leftAnchor="277.0" AnchorPane.topAnchor="14.0" />
    
    <!-- Report Type Selection -->
    <HBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.topAnchor="50" />
    
    <!-- Date Range Selection -->
    <HBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.topAnchor="100" />
    
    <!-- Placeholder for Pie Chart (Performance Report) -->
    <PieChart fx:id="performancePieChart" prefHeight="250" prefWidth="300" title="Performance Report" visible="false" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" />
     <Label layoutX="24.0" layoutY="149.0" text="From:" />
     <DatePicker fx:id="startDatePicker" layoutX="72.0" layoutY="149.0" />
     <Label layoutX="300.0" layoutY="149.0" text="To:" />
     <DatePicker fx:id="endDatePicker" layoutX="330.0" layoutY="149.0" />
     <Button layoutX="558.0" layoutY="149.0" onAction="#handleGenerateReport" text="Generate Report" />
     <Label layoutX="78.0" layoutY="66.0" text="Select Report Type:" />
     <ComboBox fx:id="reportTypeComboBox" layoutX="216.0" layoutY="66.0" />
      <Label layoutX="330.0" layoutY="66.0" text="Select Restaurant:" />
     <ComboBox fx:id="restaurantComboBox" layoutX="458.0" layoutY="66.0" />
    
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="685.0" prefWidth="770.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.RestaurantWorkerController">
    
    <TableView fx:id="ordersTableView" layoutX="10.0" layoutY="10.0" prefHeight="480.0" prefWidth="756.0">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="70.0" text="Order ID" />
            <TableColumn fx:id="dishesColumn" prefWidth="502.0" text="Dishes + Remarks" />
            <TableColumn fx:id="orderStatusColumn" prefWidth="121.0" text="Order Status" />
        </columns>
    </TableView>

    <Button layoutX="41.0" layoutY="504.0" onAction="#handleRefreshOrders" prefHeight="38.0" prefWidth="119.0" text="Refresh Orders" />
    <Button fx:id="inPreparationButton" layoutX="260.0" layoutY="496.0" onAction="#handleInPreparationButton" prefHeight="54.0" prefWidth="114.0" text="In Preparation" />
    <Button fx:id="inDeliveryButton" layoutX="418.0" layoutY="496.0" onAction="#handleInDeliveryButton" prefHeight="54.0" prefWidth="114.0" text="In Delivery" />
    <Button alignment="CENTER" layoutX="359.0" layoutY="622.0" onAction="#handleExitButton" prefHeight="31.0" prefWidth="59.0" text="Exit" />
    

</AnchorPane>

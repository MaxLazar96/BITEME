<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="532.0" prefWidth="496.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.SelectRestaurantController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
    
    <TableView fx:id="restaurantTableView">
        <columns>
           
            <TableColumn fx:id="nameColumn" prefWidth="195.0" text="Restaurant Name" />
            <TableColumn fx:id="addressColumn" prefWidth="92.0" text="Address" />
            <TableColumn fx:id="branchColumn" prefWidth="99.0" text="Branch" />
        </columns>
    </TableView>
    
    <Button alignment="CENTER" contentDisplay="CENTER" onAction="#handleSelectRestaurantButtonClick" text="Select Restaurant">
      <opaqueInsets>
         <Insets />
      </opaqueInsets></Button>
</VBox>

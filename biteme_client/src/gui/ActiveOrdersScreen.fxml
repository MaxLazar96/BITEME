<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="684.0" prefWidth="715.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.ActiveOrdersController">
    <TableView fx:id="activeOrdersTable" layoutX="10.0" layoutY="10.0" prefHeight="544.0" prefWidth="694.0">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="70.0" text="Order ID" />
            <TableColumn fx:id="detailsColumn" prefWidth="300.0" text="Details" />
            <TableColumn fx:id="deliveryTypeColumn" prefWidth="153.0" text="Delivery Type" />
            <TableColumn fx:id="statusColumn" prefWidth="164.0" text="Status" />
        </columns>
    </TableView>
    <Button fx:id="acceptDeliveryButton" layoutX="10.0" layoutY="557.0" onAction="#handleAcceptDeliveryButton" prefHeight="50.0" prefWidth="123.0" text="Accept Delivery" />
   <Button layoutX="37.0" layoutY="625.0" mnemonicParsing="false" onAction="#handleRefreshBtn" text="Refresh" />
</AnchorPane>
